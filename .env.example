RULEATLAS_RULE_REPO=../detection-rules
RULEATLAS_RULE_REPO_CONTENT_ROOT=contents
RULEATLAS_GITHUB_REMOTE=origin
RULEATLAS_GITHUB_BASE_BRANCH=main
RULEATLAS_ATTACK_DATA_REPO=../../DetectionEngineering/attack_data
RULEATLAS_ATTACK_DATA_MAX_DATASETS=5

# Use one GitHub token variable, or authenticate the local gh CLI.
GITHUB_TOKEN=

# SPLUNK_HOST can derive the default 8088/8089 URLs. Explicit URLs take precedence.
SPLUNK_HOST=splunk.local
SPLUNK_HEC_URL=https://splunk.local:8088
SPLUNK_API_URL=https://splunk.local:8089
SPLUNK_INDEX=attack_data
SPLUNK_VERIFY_TLS=true
SPLUNK_HEC_TOKEN=
SPLUNK_API_TOKEN=
